# Copy to .env and fill in values. See repo root .env.example for the full list.

NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/saas-booking
JWT_SECRET=
BASE_URL=http://localhost:4200

CLIENT_ORIGIN=http://localhost:4200
SUPER_ADMIN_EMAILS=
# WARNING: Keep this false in production unless you have invite-only logic in place.
# Setting this to true allows anyone on the internet to create an account.
ALLOW_PUBLIC_REGISTER=false

# Meta Pixel + Conversions API — deferred to post-launch growth phase

GA_ID=
STRIPE_KEY=

# Public customer OTP SMS (required in production for /auth/request-otp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+9725...
# Local only: accept demo code 123456 without SMS
# PUBLIC_DEV_OTP_BYPASS=true

# Owner/admin password-reset email (required in production)
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@boki.co.il

E2E_TEST_SEED_SECRET=
E2E_SEED_SUPER_ADMIN_EMAIL=
E2E_SEED_SUPER_ADMIN_PASSWORD=
