# Copy to .env and fill in values. See repo root .env.example for the full list.

NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/saas-booking
JWT_SECRET=
BASE_URL=http://localhost:4200

CLIENT_ORIGIN=http://localhost:4200
SUPER_ADMIN_EMAILS=
# WARNING: Keep this false in production unless you have invite-only logic in place.
# Setting this to true allows anyone on the internet to create an account.
ALLOW_PUBLIC_REGISTER=false

# Meta Pixel + Conversions API — deferred to post-launch growth phase

GA_ID=
STRIPE_KEY=

# Public customer OTP SMS (required in production for /auth/request-otp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+9725...
# Local only: accept demo code 123456 without SMS
# PUBLIC_DEV_OTP_BYPASS=true

# Owner/admin password-reset email (required in production)
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@boki.co.il

E2E_TEST_SEED_SECRET=
E2E_SEED_SUPER_ADMIN_EMAIL=
E2E_SEED_SUPER_ADMIN_PASSWORD=

# Rate limiting — all optional, sensible defaults per NODE_ENV (generous in
# development, strict in production). See src/middleware/rateLimits.ts.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
# RATE_LIMIT_MAX_SENSITIVE=10
# RATE_LIMIT_MAX_OTP=5
# RATE_LIMIT_MAX_OTP_VERIFY=5
# RATE_LIMIT_MAX_OTP_IP=20
# RATE_LIMIT_MAX_PUBLIC=100
# RATE_LIMIT_MAX_API=300
# RATE_LIMIT_MAX_ADMIN=100

# Express `trust proxy` — must match real infra (e.g. one hop behind an AWS ALB)
# or client IPs collapse to the load balancer's own IP / become spoofable via
# X-Forwarded-For. Defaults: 1 in production, false in development.
# Accepts: false | true | an integer hop count | a subnet/CIDR list.
# TRUST_PROXY=1

# ─── Dev fixture accounts (`npm run seed:dev`) ───────────────────────────────
# Creates/resets a fixed set of test accounts for manual browser verification.
# Refuses to run when NODE_ENV=production. Safe to re-run.
#
# Super admin — always dev-super-admin@example.test (won't pass requireSuperAdmin
#   until that email is actually listed in SUPER_ADMIN_EMAILS above — the script
#   tells you the exact line to add if it isn't).
#   password: DevSuperAdmin123!
#
# Owner — dev-owner@example.test / DevOwner123!
#   business: "Dev Test Business" (slug: dev-test-business)
#
# Staff — dev-staff@example.test / DevStaff123!
#   same business as the owner above.
#
# Customer — phone 0500000000, public site at /b/dev-test-business.
#   Logs in via OTP (no password) — requires PUBLIC_DEV_OTP_BYPASS=true above,
#   code 123456. Never enable PUBLIC_DEV_OTP_BYPASS in production.
