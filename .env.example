# --- API (required for apps/api) ---
# Options: development | production
# MUST be set to "production" in your deployment environment
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/saas-booking
JWT_SECRET=
BASE_URL=http://localhost:4200

# CORS (optional; defaults to http://localhost:4200)
CLIENT_ORIGIN=http://localhost:4200

# Super admin (optional; comma-separated emails)
SUPER_ADMIN_EMAILS=

# Public registration: set true to allow POST /auth/register in production
ALLOW_PUBLIC_REGISTER=

# Optional analytics / payments (omit or leave empty if unused)
# Meta Pixel + Conversions API — deferred to post-launch growth phase

GA_ID=
STRIPE_KEY=

# Public customer OTP SMS (required in production)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# E2E / test seed (optional)
E2E_TEST_SEED_SECRET=
E2E_SEED_SUPER_ADMIN_EMAIL=
E2E_SEED_SUPER_ADMIN_PASSWORD=
