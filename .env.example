# --- API (required for apps/api) ---
# Options: development | production
# MUST be set to "production" in your deployment environment
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/saas-booking
JWT_SECRET=
BASE_URL=http://localhost:4200

# CORS (optional; defaults to http://localhost:4200)
CLIENT_ORIGIN=http://localhost:4200

# Super admin (optional; comma-separated emails)
SUPER_ADMIN_EMAILS=

# Public registration: set true to allow POST /auth/register in production
ALLOW_PUBLIC_REGISTER=

# Optional analytics / payments — deferred. Leave unset.
# GA_ID=
# STRIPE_KEY=

# Rate limits (optional). Unset values use the defaults in resolveRateLimitConfig:
# production window 15 minutes and development window 60 seconds.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
# RATE_LIMIT_MAX_SENSITIVE=10
# RATE_LIMIT_MAX_OTP=5
# RATE_LIMIT_MAX_OTP_VERIFY=5
# RATE_LIMIT_MAX_OTP_IP=20
# Identify in phone mode sends no SMS: per phone 10, per IP 200 (carrier NAT) in every environment.
# RATE_LIMIT_MAX_PHONE_MODE=10
# RATE_LIMIT_MAX_PHONE_MODE_IP=200
# RATE_LIMIT_MAX_PUBLIC=100
# RATE_LIMIT_MAX_API=300
# RATE_LIMIT_MAX_ADMIN=100
# Development defaults are 100, 50, 50, 200, 2000, 5000, and 2000 for those maxes.

# Express trust proxy. Production default is 1 hop; development default is false.
# TRUST_PROXY=1

# Public customer OTP SMS (required in production)
# Public client identity: otp (SMS) or phone (no code). Default phone in production.
# IDENTITY_MODE=phone

# Owner/admin password-reset email (required in production)
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@boki.co.il

# E2E / test seed (optional)
E2E_TEST_SEED_SECRET=
E2E_SEED_SUPER_ADMIN_EMAIL=
E2E_SEED_SUPER_ADMIN_PASSWORD=
